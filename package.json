{
  "name": "@kre8ivtech/sitecheck",
  "version": "0.1.0",
  "description": "Evidence-first website audits: accessibility, links, metadata, and customer journeys.",
  "type": "module",
  "license": "MIT",
  "bin": { "sitecheck": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "sitecheck.example.json"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:site": "tsx scripts/demo.ts --site",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Kre8ivTech/sitecheck.git" },
  "homepage": "https://github.com/Kre8ivTech/sitecheck#readme",
  "bugs": { "url": "https://github.com/Kre8ivTech/sitecheck/issues" },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "ipaddr.js": "2.2.0",
    "playwright": "1.64.1",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
