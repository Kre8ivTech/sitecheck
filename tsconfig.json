{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "outDir": "dist", "rootDir": "src", "declaration": true,
    "sourceMap": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
